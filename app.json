{
  "expo": {
    "name": "FitMe",
    "slug": "personal-fitness-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "scheme": "fitness",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anas.fitness"
    },
    "android": {
      "package": "com.anas.fitness",
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#0B0C0E"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFBFA",
          "image": "./splash.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FitMe adds progress photos you pick from your library.",
          "cameraPermission": "FitMe uses the camera to capture progress photos.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
